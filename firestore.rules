rules_version = '2';

// ============================================================================
// Firestore Security Rules — Sistem Penilaian v2
// SD Muhammadiyah 01 Kukusan
//
// Cara pakai:
//   1. Buka Firebase Console > project sdm01-penilaianv2
//   2. Build > Firestore Database > tab "Rules"
//   3. Salin SELURUH isi file ini, tempel menggantikan isi yang ada
//   4. Klik "Publish"
//
// Model akses:
//   - Hanya pengguna yang punya dokumen di koleksi `users` yang bisa
//     mengakses data apa pun (dibuat manual dari Firebase Console).
//   - role "admin": akses penuh ke semua kelas & semua modul.
//   - role "guru_tahsin_tahfizh": hanya boleh baca/tulis data
//     Tahsin-Tahfizh untuk kelas yang ada di daftar `kelasAmpu` miliknya.
//   - role "guru_akademik": hanya boleh baca/tulis data Akademik & Rapor
//     (lihat blok `mapel` & `tp_kktp` di bawah).
//   - role "orangtua": HANYA kalau status == 'approved', hanya boleh BACA
//     (read-only) data anak-anaknya sendiri (anakIds) di modul
//     Tahsin-Tahfizh. Akun dibuat sendiri (self-signup, lihat users/{uid})
//     tapi tidak bisa mengakses apa pun sampai admin menyetujui lewat
//     halaman Kelola Akun Ortu di dalam aplikasi.
//   - Role SENGAJA dicek spesifik per modul, bukan sekadar "punya
//     kelasAmpu/penugasan" — supaya guru satu modul tidak otomatis
//     kebagian akses ke modul lain hanya karena kebetulan bentuk
//     datanya mirip. Lihat komentar di bolehKelas() untuk detail.
//   - users/{uid} milik guru_akademik juga menyimpan dua field datar
//     turunan dari `penugasan` khusus untuk pengecekan rule ini:
//     `penugasanKelas` (kode kelas saja) dan `penugasanKelasMapel`
//     (string "KELAS::MAPEL"). Keduanya diisi manual bersamaan dengan
//     `penugasan` — lihat README bagian Akademik & Rapor.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    // Profil pengguna yang sedang login (nama, role, kelasAmpu).
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isLoggedIn() && myProfile().role == 'admin';
    }

    // Orang tua yang sudah disetujui admin (lihat blok users/{uid} di bawah
    // untuk alur pendaftaran & persetujuannya).
    function isApprovedOrangtua() {
      return isLoggedIn() && myProfile().role == 'orangtua' && myProfile().status == 'approved';
    }

    // Orang tua boleh lihat data anaknya sendiri (siswaId = NIS = Document ID siswa).
    function anakSaya(siswaId) {
      return isApprovedOrangtua() && siswaId in myProfile().anakIds;
    }

    // Boleh akses kelas tertentu kalau admin, atau dia guru_tahsin_tahfizh
    // dengan kelas itu ada di kelasAmpu-nya. Sengaja dicek role-nya secara
    // spesifik (bukan cuma "ada kelasAmpu") — supaya guru mapel lain yang
    // nanti juga punya field kelasAmpu (untuk modul Akademik, dst) TIDAK
    // ikut kebagian akses ke data Tahsin-Tahfizh hanya karena kebetulan
    // field & kode kelasnya sama.
    function bolehKelas(kelas) {
      return isLoggedIn() && (
        myProfile().role == 'admin' ||
        (myProfile().role == 'guru_tahsin_tahfizh' && kelas in myProfile().kelasAmpu)
      );
    }

    // Guru modul Akademik & Rapor — dicek dengan role spesifik "guru_akademik"
    // (BUKAN "guru" generik), dengan alasan yang sama seperti bolehKelas() di
    // atas: users/{uid}.penugasan (dipakai Akademik) berbentuk array
    // {kelas, mapel}, mirip secara struktur dengan kelasAmpu milik
    // Tahsin-Tahfizh — kalau role tidak dicek spesifik, ada risiko satu
    // guru modul lain kebagian akses tak sengaja ke modul ini, atau
    // sebaliknya.
    function isGuruAkademik() {
      return isLoggedIn() && myProfile().role == 'guru_akademik';
    }

    // Akses berbasis KELAS SAJA untuk guru_akademik (dipakai baca roster
    // siswa — bukan data spesifik-mapel, jadi guru mapel apa pun di kelas
    // itu boleh lihat). Field `penugasanKelas` adalah daftar datar kode
    // kelas, diturunkan dari `penugasan` — dibuat terpisah supaya
    // pengecekannya memakai operator `in` pada list datar, pola yang
    // SUDAH TERBUKTI jalan di bolehKelas() di atas, bukan pencocokan ke
    // dalam array-berisi-objek yang belum pernah diuji ke Firestore
    // sungguhan. Data siswa itu data pribadi anak — sengaja tidak dikira-kira.
    function bolehKelasAkademik(kelas) {
      return isLoggedIn() && (
        myProfile().role == 'admin' ||
        (myProfile().role == 'guru_akademik' && kelas in myProfile().penugasanKelas)
      );
    }

    // Akses berbasis KELAS + MAPEL spesifik (dipakai data nilai). Field
    // `penugasanKelasMapel` berisi string gabungan "KELAS::MAPEL" (mis.
    // "4A::Matematika"), juga diturunkan manual dari `penugasan` — alasan
    // sama seperti bolehKelasAkademik() di atas.
    function bolehMapelKelas(mapel, kelas) {
      return isLoggedIn() && (
        myProfile().role == 'admin' ||
        (myProfile().role == 'guru_akademik' && (kelas + '::' + mapel) in myProfile().penugasanKelasMapel)
      );
    }

    // Akses khusus WALI KELAS (dipakai absensi & keputusan naik kelas).
    // SENGAJA terpisah dari bolehKelasAkademik()/bolehMapelKelas() — punya
    // penugasan mengajar mapel di suatu kelas TIDAK otomatis berarti wali
    // kelas kelas itu (persis seperti di aplikasi lama: guru bidang studi
    // ditolak akses absensi). Field `waliKelas` adalah daftar datar kode
    // kelas tempat orang itu berperan sebagai wali kelas — array (bukan
    // satu string) supaya kelas dengan 2 wali kelas/guru pendamping (mis.
    // 5A) bisa menandai kedua akun.
    function bolehWaliKelas(kelas) {
      return isLoggedIn() && (
        myProfile().role == 'admin' ||
        (myProfile().role == 'guru_akademik' && kelas in myProfile().waliKelas)
      );
    }

    // ---- users/{uid} ---------------------------------------------------
    // Profil pengguna (nama, role, kelasAmpu/penugasan). Guru/admin dibuat
    // manual lewat Console. Orang tua BOLEH bikin akun sendiri (self-signup)
    // tapi HANYA sebagai role "orangtua" berstatus "pending" — tidak bisa
    // self-assign admin/guru atau langsung approved. Admin menyetujui lewat
    // update (dari halaman Kelola Akun Ortu, bukan Console).
    match /users/{uid} {
      allow get: if isLoggedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isLoggedIn() && request.auth.uid == uid
                     && request.resource.data.role == 'orangtua'
                     && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- siswa/{id} ------------------------------------------------------
    // Data siswa. Guru hanya boleh membaca siswa dari kelas yang diampunya
    // — Tahsin-Tahfizh lewat bolehKelas(), Akademik lewat
    // bolehKelasAkademik() (OR murni tambahan, jalur Tahsin di atas tidak
    // diubah). Orang tua yang sudah disetujui boleh get (bukan list)
    // anaknya sendiri. Menulis (seed/migrasi data) khusus admin.
    match /siswa/{id} {
      allow get: if bolehKelas(resource.data.kelas) || bolehKelasAkademik(resource.data.kelas) || anakSaya(id);
      allow list: if bolehKelas(resource.data.kelas) || bolehKelasAkademik(resource.data.kelas);
      allow write: if isAdmin();
    }

    // ---- kktp_tahsin_tahfizh/{jenjang} ------------------------------------
    // Sudah tidak dipakai aktif (KKTP digantikan Baca & Tandai), dibiarkan
    // untuk kompatibilitas. Baca oleh siapa pun yang login, tulis khusus admin.
    match /kktp_tahsin_tahfizh/{jenjang} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ---- setoran/{id} ------------------------------------------------------
    // Riwayat setoran harian. Guru hanya boleh baca/tambah untuk kelas
    // yang diampunya. Orang tua boleh baca setoran anaknya sendiri saja
    // (read-only, tidak pernah bisa create/delete). Hapus hanya untuk
    // entri milik sendiri.
    match /setoran/{id} {
      allow read: if bolehKelas(resource.data.kelas) || anakSaya(resource.data.siswaId);
      allow create: if isLoggedIn()
                     && request.resource.data.createdBy == request.auth.uid
                     && bolehKelas(request.resource.data.kelas);
      allow delete: if isLoggedIn() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    // ---- menulis_log/{id} ---------------------------------------------------
    // Catatan pemeriksaan berkala buku salinan Al-Qur'an. Aturan sama
    // seperti setoran (termasuk akses baca-saja untuk orang tua).
    match /menulis_log/{id} {
      allow read: if bolehKelas(resource.data.kelas) || anakSaya(resource.data.siswaId);
      allow create: if isLoggedIn()
                     && request.resource.data.createdBy == request.auth.uid
                     && bolehKelas(request.resource.data.kelas);
      allow delete: if isLoggedIn() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    // ---- target_hafalan/{kelas} ---------------------------------------------
    // Target surah (Quran) / jilid+halaman (Iqro) per kelas per semester.
    // ID dokumen = kode kelas, jadi tinggal dicocokkan dengan kelasAmpu.
    // Target bukan data sensitif per-siswa, jadi orang tua yang sudah
    // disetujui boleh lihat target kelas mana pun.
    match /target_hafalan/{kelas} {
      allow read: if bolehKelas(kelas) || isApprovedOrangtua();
      allow write: if bolehKelas(kelas);
    }

    // ==========================================================================
    // Modul Akademik & Rapor
    // ==========================================================================

    // ---- mapel/{nama} ----------------------------------------------------
    // Data referensi mapel (bobot SLM/SAS, kelompok, urutan cetak). ID
    // dokumen SENGAJA berupa nama mapel persis (mis. "Matematika"), bukan
    // kode singkat, supaya cocok langsung dengan users/{uid}.penugasan[].mapel
    // tanpa tabel terjemahan. Isinya bukan data sensitif (bukan data siswa),
    // jadi baca dibuka untuk siapa pun yang login — termasuk guru
    // Tahsin-Tahfizh, tidak masalah. Tulis khusus admin, mengikuti pola
    // kktp_tahsin_tahfizh di atas.
    match /mapel/{nama} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ---- tp_kktp/{id} ------------------------------------------------------
    // Tujuan Pembelajaran + 4 level KKTP per mapel & TINGKATAN (angka
    // kelas, mis. "4" — bukan per kelas paralel, karena 4A & 4B memakai
    // kurikulum yang sama dan boleh diedit bersama oleh guru mapel yang
    // mengampu salah satunya).
    //
    // CATATAN KEAMANAN — sengaja belum sehalus bolehKelas(): idealnya
    // aturan di sini mencocokkan mapel & tingkatan pada dokumen terhadap
    // penugasan spesifik guru (persis seperti bolehKelas() mencocokkan
    // kelas). Tapi penugasan tersimpan sebagai array {kelas, mapel} per
    // KELAS PARALEL (mis. "4A"), sedangkan TP disimpan per TINGKATAN
    // ("4") — mencocokkan keduanya perlu mengambil awalan angka dari tiap
    // elemen array di dalam rule, yang tidak sederhana ditulis maupun
    // diuji di Firestore Rules. Karena isi TP/KKTP adalah kriteria
    // kurikulum (bukan nilai/data pribadi siswa), risikonya jauh lebih
    // rendah daripada koleksi nilai nanti — untuk saat ini cukup dibatasi
    // per ROLE (harus guru_akademik atau admin), belum per mapel/tingkatan
    // spesifik. WAJIB diperketat ke pencocokan penugasan yang sebenarnya
    // sebelum koleksi nilai (data nilai siswa sungguhan) dibangun.
    match /tp_kktp/{id} {
      allow read: if isLoggedIn();
      allow write: if isAdmin() || isGuruAkademik();
    }

    // ---- config/akademik ---------------------------------------------------
    // Semester & tahun ajaran aktif (satu dokumen untuk seluruh sekolah).
    // Dikelola admin, dibaca semua modul Akademik yang butuh tahu "sekarang
    // semester berapa" saat menyimpan nilai.
    match /config/akademik {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ---- nilai_slm/{id} -----------------------------------------------------
    // Nilai Sumatif Lingkup Materi — satu dokumen per (siswa × TP × semester
    // × tahun ajaran). Dibatasi persis per kelas+mapel lewat
    // bolehMapelKelas() — TIDAK seperti tp_kktp, di sini pencocokannya bisa
    // presisi karena nilai memang terikat ke kelas spesifik (bukan
    // tingkatan), jadi tidak ada masalah tebak-tebakan huruf paralel
    // seperti di tp_kktp.
    match /nilai_slm/{id} {
      allow read: if bolehMapelKelas(resource.data.mapel, resource.data.kelas);
      allow create: if isLoggedIn()
                     && request.resource.data.createdBy == request.auth.uid
                     && bolehMapelKelas(request.resource.data.mapel, request.resource.data.kelas);
      allow update: if bolehMapelKelas(resource.data.mapel, resource.data.kelas)
                     && bolehMapelKelas(request.resource.data.mapel, request.resource.data.kelas);
      allow delete: if isAdmin();
    }

    // ---- nilai_sas/{id} -----------------------------------------------------
    // Nilai Sumatif Akhir Semester — SATU dokumen per (siswa × mapel ×
    // semester × tahun ajaran), BUKAN per TP (koreksi dari aplikasi lama,
    // lihat README). Aturan sama seperti nilai_slm.
    match /nilai_sas/{id} {
      allow read: if bolehMapelKelas(resource.data.mapel, resource.data.kelas);
      allow create: if isLoggedIn()
                     && request.resource.data.createdBy == request.auth.uid
                     && bolehMapelKelas(request.resource.data.mapel, request.resource.data.kelas);
      allow update: if bolehMapelKelas(resource.data.mapel, resource.data.kelas)
                     && bolehMapelKelas(request.resource.data.mapel, request.resource.data.kelas);
      allow delete: if isAdmin();
    }

    // ---- absensi_rapor/{id} -------------------------------------------------
    // Rekap absensi semester + catatan wali + keputusan naik/tinggal kelas.
    // Satu dokumen per (siswa × semester × tahun ajaran). KHUSUS wali
    // kelas (bolehWaliKelas) — guru mapel biasa di kelas itu TIDAK ikut
    // kebagian akses, persis pola aplikasi lama.
    match /absensi_rapor/{id} {
      allow read: if bolehWaliKelas(resource.data.kelas);
      allow create: if isLoggedIn()
                     && request.resource.data.createdBy == request.auth.uid
                     && bolehWaliKelas(request.resource.data.kelas);
      allow update: if bolehWaliKelas(resource.data.kelas)
                     && bolehWaliKelas(request.resource.data.kelas);
      allow delete: if isAdmin();
    }

    // ---- dpl/{id} -----------------------------------------------------------
    // Referensi 8 Dimensi Profil Lulusan (nama, status aktif, deskripsi per
    // level). Bukan data sensitif, jadi baca dibuka untuk siapa pun yang
    // login. Tulis khusus admin — mengikuti pola mapel/{nama}.
    match /dpl/{id} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ---- kokurikuler/{id} ---------------------------------------------------
    // Nilai kokurikuler (level 1-4 per DPL per siswa). KHUSUS wali kelas,
    // sama seperti absensi_rapor — guru mapel biasa tidak ikut kebagian
    // akses walau mengajar di kelas itu.
    match /kokurikuler/{id} {
      allow read: if bolehWaliKelas(resource.data.kelas);
      allow create: if isLoggedIn()
                     && request.resource.data.createdBy == request.auth.uid
                     && bolehWaliKelas(request.resource.data.kelas);
      allow update: if bolehWaliKelas(resource.data.kelas)
                     && bolehWaliKelas(request.resource.data.kelas);
      allow delete: if isAdmin();
    }

    // ---- Semua koleksi lain: default tertutup --------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
